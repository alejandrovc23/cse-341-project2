{
  "openapi": "3.0.3",
  "info": {
    "title": "Library API",
    "version": "2.0.0",
    "description": "REST API for managing authors and books in MongoDB. GET operations are public. POST, PUT, and DELETE operations require a GitHub OAuth session. To authenticate, open /auth/github in this browser, complete GitHub authorization, and return to Swagger."
  },
  "servers": [
    {
      "url": "https://project2-vxz5.onrender.com",
      "description": "Render production deployment"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "GitHub OAuth login, session status, and logout"
    },
    {
      "name": "Authors",
      "description": "Author CRUD operations"
    },
    {
      "name": "Books",
      "description": "Book CRUD operations"
    },
    {
      "name": "System",
      "description": "Service status"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get API information",
        "responses": {
          "200": {
            "description": "API information returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "example": "Library API"
                    },
                    "version": {
                      "type": "string",
                      "example": "2.0.0"
                    },
                    "documentation": {
                      "type": "string",
                      "example": "/api-docs"
                    },
                    "authentication": {
                      "type": "string",
                      "example": "/auth/status"
                    },
                    "resources": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "/authors",
                        "/books"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Check service health",
        "responses": {
          "200": {
            "description": "Service is available",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/github": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log in or create an account with GitHub",
        "description": "Open this URL directly in a browser. On the first successful login, the API creates a users collection record from the GitHub profile. GitHub then redirects back to Swagger UI with a session cookie.",
        "responses": {
          "302": {
            "description": "Redirect to GitHub for authorization",
            "headers": {
              "Location": {
                "description": "GitHub authorization URL",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "An unexpected server error occurred"
                }
              }
            }
          },
          "503": {
            "description": "GitHub OAuth is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "GitHub OAuth is not configured on this server"
                }
              }
            }
          }
        }
      }
    },
    "/auth/github/callback": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Complete the GitHub OAuth flow",
        "description": "GitHub calls this endpoint. It creates or updates the user, establishes the session, and redirects to Swagger UI.",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Authentication completed; redirect to Swagger UI"
          },
          "401": {
            "description": "GitHub authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "GitHub authentication failed"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "An unexpected server error occurred"
                }
              }
            }
          },
          "503": {
            "description": "GitHub OAuth is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "GitHub OAuth is not configured on this server"
                }
              }
            }
          }
        }
      }
    },
    "/auth/status": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Check the current session",
        "responses": {
          "200": {
            "description": "Current authentication status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "authenticated",
                    "user"
                  ],
                  "properties": {
                    "authenticated": {
                      "type": "boolean",
                      "example": true
                    },
                    "user": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/User"
                        }
                      ],
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "An unexpected server error occurred"
                }
              }
            }
          }
        }
      }
    },
    "/auth/failure": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Report a failed GitHub authentication",
        "description": "The OAuth callback redirects here when GitHub authentication is unsuccessful.",
        "responses": {
          "401": {
            "description": "GitHub authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "GitHub authentication failed"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log out and destroy the current session",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Logged out successfully"
          },
          "401": {
            "description": "Authentication is required",
